# Chemins Windows. Préférer un chemin UNC si le processus tourne
# sous un autre compte que la session (lecteur L: invisible).
# Production déclarée : L:\Chris\2026\BI\Entrée et \Sortie
# Requêtes M actuelles : D:\SBM\BI_SBM\Entrée et \Sortie
ENTREE_DIR=D:\SBM\BI_SBM\Entrée
SORTIE_DIR=D:\SBM\BI_SBM\Sortie

# Copies locales atomiques (jamais les sources)
STAGING_DIR=data/staging
REJECTED_DIR=data/rejected
LOG_DIR=logs
LOG_LEVEL=INFO

HEADER_SCAN_MAX_ROWS=200
ALLOW_HEADER_FALLBACK=false
ALLOW_FIRST_SHEET_FALLBACK=false
DATE_DAYFIRST=true

SCAN_INTERVAL_SECONDS=60
WATCH_USE_POLLING=false
STABILITY_REQUIRED_CHECKS=3
STABILITY_CHECK_SECONDS=2
MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=5

# PostgreSQL — ne jamais committer .env
# Préférer DB_PASSWORD_FILE (fichier secret) à DB_PASSWORD.
DB_HOST=your_hostdb
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_user_name
DB_PASSWORD=your_password   
DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
